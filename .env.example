# Copy this file to .env and fill in your own values.
# See README.md's "Configuration" section for the full reference.

# Required: your Nexus server URL (no trailing slash)
NEXUS_URL=https://nexus.example.com/nexus

# Authentication -- choose ONE of the two options below.

# Option 1: API Token (recommended)
NEXUS_API_TOKEN=your-api-token-here

# Option 2: Username & Password
#NEXUS_USERNAME=admin
#NEXUS_PASSWORD=your-password

# Optional
#LOG_LEVEL=INFO
#ALLOW_INSECURE=false
#NEXUS_REPO_INFO_URL=

# Optional: hosted multi-user HTTP transport (see README's "Hosted /
# Multi-user Deployment" section) -- leave MCP_TRANSPORT unset/"stdio" for
# the normal single-user setup above.
#MCP_TRANSPORT=stdio
#MCP_HTTP_HOST=0.0.0.0
#MCP_HTTP_PORT=8000
